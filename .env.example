NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Netlify Function variable. Never use NEXT_PUBLIC_ for this.
# Do NOT commit its real value or send it through chat.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVER_SECRET_KEY

# Private administrator code for the one-time SKYWALKER ZIP intake page.
# Configure this in Netlify only; never commit the real value.
NEST_ADMIN_CODE=GENERATE_A_LONG_RANDOM_ADMIN_CODE
NEXT_PUBLIC_SITE_URL=https://nestclientgallery.netlify.app
